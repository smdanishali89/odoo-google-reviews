    {
      "parameters": {
        "jsCode": "const query = $('Google OAuth Callback').first().json.query || {};\nif (!query.state) throw new Error('Missing OAuth state');\nconst tokens = $input.first().json;\nif (!tokens.refresh_token) throw new Error('Google did not return a refresh token; revoke app access and authorize again with consent');\nconst state = JSON.parse(Buffer.from(query.state, 'base64url').toString('utf8'));\nconst raw = state.return_url || '';\nconst match = raw.match(/^(https?):\\/\\/([^/?#]+)(\\/[^?#]*)?$/i);\nif (!match || match[2].includes('@') || (match[3] || '/') !== '/google_reviews/oauth/callback') throw new Error('Invalid Odoo callback URL');\nconst protocol = match[1].toLowerCase();\nconst hostname = match[2].split(':')[0].toLowerCase();\nif (protocol !== 'https' && !(protocol === 'http' && ['localhost', '127.0.0.1'].includes(hostname))) throw new Error('Odoo callback must use HTTPS (HTTP allowed only for local testing)');\nconst fragment = 'state=' + encodeURIComponent(query.state) + '&refresh_token=' + encodeURIComponent(tokens.refresh_token) + '&access_token=' + encodeURIComponent(tokens.access_token || '') + '&expires_in=' + encodeURIComponent(String(tokens.expires_in || 3600));\nreturn [{json: {redirect_url: raw + '#' + fragment}}];"
      },
